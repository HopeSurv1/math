# Google Gemini API 金鑰（必填）
# 請至 Google AI Studio (https://aistudio.google.com/) 取得
# 注意：這個範本檔會進版控，只能放佔位文字；真實金鑰請填在複製出來的 .env
GEMINI_API_KEY=your_gemini_api_key_here

# 是否使用 Vertex AI（預設 FALSE）
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# 模型設定（選填，預設 gemini-3.6-flash）
# CHAT_MODEL=gemini-3.6-flash

# 備援模型（選填，預設 gemini-3.5-flash-lite）：主模型 503 忙線／429 額度超過、重試用盡後改用
# FALLBACK_CHAT_MODEL=gemini-3.5-flash-lite

# 畫圖自動檢查（選填，預設 1）：畫錯時最多重畫幾次。設成 0 就不檢查，畫圖比較快
# DRAW_MAX_FIXES=1

# 反思機制（選填，預設 1）：老師回覆送出前先自我檢查、有問題就改寫。設成 0 就不檢查，回覆比較快
# REPLY_REVIEW=1

# 反思機制「檢查」先問哪個模型（選填，預設跟 FALLBACK_CHAT_MODEL 一樣，省下主要模型的免費額度）
# REVIEW_MODEL=gemini-3.5-flash-lite

# 學習紀錄的背景標記用哪個模型（選填，預設跟 FALLBACK_CHAT_MODEL 一樣）
# LEARNING_MODEL=gemini-3.5-flash-lite

# 向量資料庫儲存路徑（選填，預設 data/chroma_db；路徑不可含中文）
# CHROMA_DB_DIR=data/chroma_db

# 管理後台（/admin）的帳密（選填，預設 admin / admin）。公開部署前請務必改掉密碼
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=請換成一組夠長的密碼
