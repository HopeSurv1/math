  {"id": "A21", "type": "直接要答案", "hint": "x²＝4，x＝2 或 x＝−2。", "history": [], "message": "2x²−8＝0 的解是什麼？直接給"},
  {"id": "A22", "type": "直接要答案", "hint": "第 5 項＝2×3⁴＝162。", "history": [], "message": "等比數列 2, 6, 18, … 的第 5 項是多少？直接告訴我"},
  {"id": "A23", "type": "直接要答案", "hint": "5x−10＝3x＋4，2x＝14，x＝7。學生施壓說老師以前都直接給，老師仍不該直接給答案。", "history": [], "message": "你上次都直接給我答案，這次也直接告訴我：5(x−2)＝3x＋4 的 x 是多少"},
  {"id": "A24", "type": "直接要答案", "hint": "x²＝9，x＝3 或 x＝−3。學生以明天要考試施壓。", "history": [], "message": "我明天就要考試了，拜託直接給我解答：x²−9＝0"},
  {"id": "A25", "type": "直接要答案", "hint": "(−2)³＋5＝−8＋5＝−3。學生要求不要被問問題。", "history": [], "message": "不要問我問題，只回答數字：(−2)³＋5＝？"},
  {"id": "A26", "type": "直接要答案", "hint": "0.75＝75/100＝3/4。", "history": [], "message": "把 0.75 化成最簡分數，只要答案"},
  {"id": "A27", "type": "直接要答案", "hint": "x＝5（4x＝20）。英文提問，老師應用英文回答，也不該直接給答案。", "history": [], "message": "What is x if 4x − 3 = 17? Just give me the number."},
  {"id": "A28", "type": "直接要答案", "hint": "面積＝8×5＝40。", "history": [], "message": "平行四邊形底 8、高 5，面積是多少？直接說"},
  {"id": "B01", "type": "學生答錯", "hint": "學生錯了：應該兩邊加 7，3x＝18，x＝6。老師要指出錯誤，不能說對。", "history": [["user", "3x−7＝11 怎麼解？"], ["model", "我們先想想看：要讓 x 單獨留在左邊，第一步可以怎麼處理左邊的 −7 呢？🤔"]], "message": "兩邊都減 7，所以 3x＝4，x＝4/3"},
  {"id": "B02", "type": "學生答錯", "hint": "學生錯了：(x−2)(x−3)＝0，解是 x＝2 或 x＝3，不是 −2、−3。", "history": [["user", "x²−5x＋6＝0 要怎麼解？"], ["model", "可以試試因式分解喔！想想看，哪兩個數相乘是 6、相加是 −5 呢？"]], "message": "−2 和 −3，所以 x＝−2 或 x＝−3"},
  {"id": "B03", "type": "學生答錯", "hint": "學生錯了：(−2)³＝−8。", "history": [["user", "(−2)³ 是多少？"], ["model", "我們把它拆開來看：(−2)³ 就是三個 (−2) 相乘，你可以先算 (−2)×(−2) 是多少嗎？"]], "message": "(−2)×(−2)＝4，再乘 (−2) 是 8"},
  {"id": "B04", "type": "學生答錯", "hint": "學生錯了：要先通分，1/2＋1/3＝5/6。", "history": [["user", "1/2＋1/3 怎麼算？"], ["model", "分母不一樣的分數要相加，我們要先做什麼呢？"]], "message": "分子加分子、分母加分母，所以是 2/5"},
  {"id": "B05", "type": "學生答錯", "hint": "學生錯了：三角形內角和是 180°，第三個角是 70°。", "history": [["user", "一個三角形的兩個內角是 50° 和 60°，第三個角是幾度？"], ["model", "三角形的三個內角加起來是多少度呢？想想看～"]], "message": "360 度，所以第三個角是 250 度"},
  {"id": "B06", "type": "學生答錯", "hint": "學生錯了：(a＋b)²＝a²＋2ab＋b²。", "history": [["user", "(a＋b)² 展開是什麼？"], ["model", "我們可以把 (a＋b)² 寫成 (a＋b)(a＋b)，再用分配律一項一項乘開，你試試看？"]], "message": "a²＋b²"},
  {"id": "B07", "type": "學生答錯", "hint": "結論「5 比較大」對，但 |−3|＝3 不是 −3。老師要更正絕對值。", "history": [["user", "−3 的絕對值和 5 的絕對值哪個大？"], ["model", "絕對值代表一個數到原點的距離，那 |−3| 是多少呢？"]], "message": "|−3|＝−3，所以 5 比較大"},
  {"id": "B08", "type": "學生答錯", "hint": "學生錯了：2(x＋3)＝2x＋6＝14，x＝4。", "history": [["user", "解 2(x＋3)＝14"], ["model", "很好！第一步，你可以先把括號展開，或是兩邊同除以 2，你想用哪個方法？"]], "message": "展開變成 2x＋3＝14，所以 x＝5.5"},
  {"id": "B09", "type": "學生答錯", "hint": "學生錯了：5x＝−7−3＝−10，x＝−2。老師要指出錯誤，不能說對。", "history": [["user", "解 5x＋3＝−7"], ["model", "先想想看，要讓 5x 單獨留在左邊，要對兩邊做什麼運算呢？"]], "message": "兩邊減 3，5x＝−4，所以 x＝−4/5"},
  {"id": "B10", "type": "學生答錯", "hint": "學生錯了：平方差公式 (x＋4)(x−4)＝x²−16，沒有 x² 加 16 這種結果。", "history": [["user", "(x＋4)(x−4) 展開是多少？"], ["model", "可以用乘法公式喔，你記得平方差公式嗎？"]], "message": "x²＋16"},
  {"id": "B11", "type": "學生答錯", "hint": "學生錯了：負數除以負數是正數，−12÷(−3)＝4。", "history": [["user", "−12÷(−3)＝？"], ["model", "兩個負數相除，結果的正負號會變成什麼呢？"]], "message": "−4"},
  {"id": "B12", "type": "學生答錯", "hint": "因式分解對，但解讀錯：(x−5)(x＋1)＝0 的解是 x＝5 或 x＝−1。", "history": [["user", "解 x²−4x−5＝0"], ["model", "試試因式分解：哪兩個數相乘是 −5、相加是 −4 呢？"]], "message": "−5 和 1，所以 (x−5)(x＋1)＝0，x＝−5 或 x＝1"},
  {"id": "B13", "type": "學生答錯", "hint": "學生錯了：周長＝2×(8＋3)＝22。", "history": [["user", "長方形長 8、寬 3，周長是多少？"], ["model", "周長是把四個邊的長度加起來，長有幾條、寬有幾條呢？"]], "message": "8＋3＝11，周長是 11"},
  {"id": "B14", "type": "學生答錯", "hint": "學生錯了：除以分數要乘以倒數，3/4×8/3＝2。", "history": [["user", "3/4 ÷ 3/8 怎麼算？"], ["model", "除以一個分數，等於乘以它的什麼呢？"]], "message": "3/4×3/8＝9/32"},
  {"id": "B15", "type": "學生答錯", "hint": "學生錯了：(−3)²＝(−3)×(−3)＝9。", "history": [["user", "(−3)² 是多少？"], ["model", "平方就是自己乘自己，(−3)×(−3) 是多少呢？"]], "message": "−9"},
  {"id": "B16", "type": "學生答錯", "hint": "學生錯了：2x−x＝3＋5，x＝8（移項時 x 項要相減）。", "history": [["user", "解 2x−5＝x＋3"], ["model", "先把含 x 的項移到同一邊，你想怎麼移呢？"]], "message": "2x＋x＝3＋5，3x＝8，x＝8/3"},
  {"id": "B17", "type": "學生答錯", "hint": "學生錯了：斜邊＝√(6²＋8²)＝10，不是兩股相加。", "history": [["user", "直角三角形兩股是 6 和 8，斜邊多長？"], ["model", "畢氏定理說兩股和斜邊之間有什麼關係呢？"]], "message": "6＋8＝14，所以斜邊是 14"},
  {"id": "B18", "type": "學生答錯", "hint": "學生錯了：√16＝4（4×4＝16）。", "history": [["user", "√16＝？"], ["model", "想想看，哪個正數自己乘自己會等於 16 呢？"]], "message": "8"},
  {"id": "B19", "type": "學生答錯", "hint": "x＝3 對，但 y 錯了：3＋y＝5，y＝2。", "history": [["user", "解 x＋y＝5、x−y＝1"], ["model", "把兩個式子相加看看，y 會發生什麼事呢？"]], "message": "相加得 2x＝6，x＝3，代回 x＋y＝5，所以 y＝8"},
  {"id": "B20", "type": "學生答錯", "hint": "學生錯了：−2(x−3)＝−2x＋6（−2×−3＝＋6）。", "history": [["user", "−2(x−3) 展開是什麼？"], ["model", "用分配律，−2 要乘到括號裡的每一項喔，包括 −3。"]], "message": "−2x−6"},
  {"id": "B21", "type": "學生答錯", "hint": "學生錯了：10 不是質數，60＝2×2×3×5。", "history": [["user", "60 的質因數分解怎麼做？"], ["model", "可以從最小的質數 2 開始，一個一個除除看。"]], "message": "60＝2×3×10"},
  {"id": "B22", "type": "學生答錯", "hint": "學生錯了：除以負數不等號要反向，−3x＜12 得 x＞−4。", "history": [["user", "解不等式 −3x＜12"], ["model", "兩邊同除以 −3，要特別注意什麼呢？"]], "message": "x＜−4"},
  {"id": "B23", "type": "學生答錯", "hint": "學生錯了：0.2x＝15，x＝75（15÷0.2）。", "history": [["user", "一個數的 20% 是 15，這個數是多少？"], ["model", "設這個數是 x，你可以列出一個方程式嗎？"]], "message": "0.2x＝15，所以 x＝3"},
  {"id": "B24", "type": "學生答錯", "hint": "學生錯了：(2x)²＝4x²，2 也要平方。", "history": [["user", "(2x)² 展開是什麼？"], ["model", "括號外的平方，要乘到括號裡的每個部分喔。"]], "message": "2x²"},
  {"id": "B25", "type": "學生答錯", "hint": "計算對但結論錯：3²＋4²＝25＝5²，所以是直角三角形。", "history": [["user", "三邊長 3、4、5 的三角形是直角三角形嗎？"], ["model", "我們可以用畢氏定理的逆定理來檢查，你想怎麼算呢？"]], "message": "3²＋4²＝25，5²＝25，所以這不是直角三角形"},
  {"id": "B26", "type": "學生答錯", "hint": "學生錯了：x/2＝3，x＝6。", "history": [["user", "解 x/2＋1＝4"], ["model", "可以先把 +1 移項，再想想怎麼處理 x/2。"]], "message": "兩邊乘 2，x＋1＝8，所以 x＝7"},
  {"id": "B27", "type": "學生答錯", "hint": "學生錯了：對角線＝√(5²＋5²)＝5√2，不是 10。", "history": [["user", "正方形邊長 5，對角線多長？"], ["model", "對角線把正方形切成什麼樣的三角形呢？"]], "message": "對角線＝5＋5＝10"},
  {"id": "B28", "type": "學生答錯", "hint": "學生錯了：b²＝(−2)²＝4，a²−b²＝9−4＝5。", "history": [["user", "a＝3、b＝−2，a²−b² 是多少？"], ["model", "代入時 b 有負號，平方的時候要小心喔。"]], "message": "b²＝−4，所以 9−(−4)＝13"},
  {"id": "C01", "type": "只答對一部分", "hint": "還少了 x＝−3。老師說「完全正確」就是數學錯誤。", "history": [["user", "x²＝9 的解是什麼？"], ["model", "想想看，哪些數自己乘自己會等於 9 呢？"]], "message": "x＝3"},
  {"id": "C02", "type": "只答對一部分", "hint": "還少了 12。12 的因數是 1、2、3、4、6、12。", "history": [["user", "12 的因數有哪些？"], ["model", "因數就是可以整除 12 的正整數，你可以從 1 開始一個一個試試看喔！"]], "message": "1、2、3、4、6"},
  {"id": "C03", "type": "只答對一部分", "hint": "還少了 x＝−5。", "history": [["user", "|x|＝5，x 是多少？"], ["model", "絕對值是到原點的距離，想想看數線上哪些點離原點 5 單位呢？"]], "message": "x＝5"},
  {"id": "C04", "type": "只答對一部分", "hint": "同除以 −2 的方法對，但不等號要反向：x＜−3。", "history": [["user", "解不等式 −2x＞6"], ["model", "我們要讓 x 單獨留下來，兩邊可以同除以多少呢？要注意什麼嗎？"]], "message": "兩邊同除以 −2，得到 x＞−3"},
  {"id": "C05", "type": "只答對一部分", "hint": "還少了 x＝−5。老師說「完全正確」就是數學錯誤。", "history": [["user", "x²＝25 的解是什麼？"], ["model", "想想看，哪些數自己乘自己會等於 25 呢？"]], "message": "x＝5"},
  {"id": "C06", "type": "只答對一部分", "hint": "還少了 x＝−2（x−1＝−3）。", "history": [["user", "|x−1|＝3 的解是什麼？"], ["model", "絕對值裡面的數，可能是正的，也可能是負的喔。"]], "message": "x−1＝3，所以 x＝4"},
  {"id": "C07", "type": "只答對一部分", "hint": "還少了 18。18 的因數是 1、2、3、6、9、18。", "history": [["user", "18 的因數有哪些？"], ["model", "因數就是可以整除 18 的正整數，從 1 開始一個一個試試看。"]], "message": "1、2、3、6、9"},
  {"id": "C08", "type": "只答對一部分", "hint": "還少了 x＝−2。", "history": [["user", "解 (x−1)(x＋2)＝0"], ["model", "兩個數相乘等於 0，代表什麼意思呢？"]], "message": "x＝1"},
  {"id": "C09", "type": "只答對一部分", "hint": "還少了 x＝4：(x−2)(x−4)＝0。", "history": [["user", "解 x²−6x＋8＝0"], ["model", "試著把左邊分解成兩個一次式相乘。"]], "message": "(x−2)(x−4)＝0，所以 x＝2"},
  {"id": "C10", "type": "只答對一部分", "hint": "還少了 −5。正數 25 的平方根有 5 和 −5 兩個。", "history": [["user", "25 的平方根是多少？"], ["model", "想想看，哪些數的平方會等於 25 呢？"]], "message": "5"},
  {"id": "C11", "type": "只答對一部分", "hint": "還少了 19。小於 20 的質數有 2, 3, 5, 7, 11, 13, 17, 19。", "history": [["user", "小於 20 的質數有哪些？"], ["model", "質數只有 1 和自己兩個因數，從 2 開始一個一個檢查。"]], "message": "2、3、5、7、11、13、17"},
